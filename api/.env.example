# Copie este arquivo para ".env" e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API Keys)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=cole-aqui-a-anon-ou-publishable-key
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-service-role-ou-secret-key

# Porta da API e endereço onde o front abre (usado no link do e-mail de "esqueci minha senha")
PORT=3000
FRONT_URL=http://localhost:3000
